{
  "name": "garmin-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Remote MCP server (Cloudflare Workers + OAuth 2.0/DCR) exposing Garmin Connect Personal API data to Gemini and other MCP clients.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "^0.34.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.168.0"
  }
}
