/**
 * Cloudflare Worker configuration for the Garmin MCP server.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "garmin-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-20",
	"compatibility_flags": [
		// Needed by the MCP SDK / agents packages.
		"nodejs_compat",
		// Required by @cloudflare/workers-oauth-provider when Client ID Metadata
		// Documents (CIMD) are enabled: outbound fetches may only reach public hosts.
		"global_fetch_strictly_public"
	],

	// Serve on https://garmin-mcp.<your-subdomain>.workers.dev
	"workers_dev": true,
	// Don't expose extra per-version preview hostnames.
	"preview_urls": false,

	// McpAgent runs every MCP session inside a Durable Object.
	// agents' McpAgent.serve() looks for the binding named MCP_OBJECT by default.
	"durable_objects": {
		"bindings": [
			{
				"name": "MCP_OBJECT",
				"class_name": "GarminMCP"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["GarminMCP"]
		}
	],

	// OAuth state (clients, grants, hashed tokens) + the cached, encrypted Garmin access token.
	// No "id" on purpose: on the first deploy Wrangler creates this KV namespace automatically,
	// and later deploys keep using the namespace already bound to the deployed Worker.
	// (Wrangler may write the new id back here after an interactive deploy; that's fine too.)
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV"
		}
	],

	"vars": {
		// Timezone that decides what "today" means when a tool call omits a date.
		// "auto" uses the time zone in your Garmin profile (falls back to UTC); or name one, e.g. "Europe/Berlin".
		"TIMEZONE": "auto"
	},

	// Set with: npx wrangler secret put <NAME>
	"secrets": {
		"required": ["GARMIN_PERSONAL_API_KEY", "MCP_ADMIN_PASSWORD"]
	},

	"observability": {
		"enabled": true
	}
}
